# Copy this file to .env and fill in real values (.env is gitignored).

# Search results page to scrape, including query params.
QCLI_BASE_URL=https://example.com/search?q=1080

# CSS selector (relative to the fetched document) matching each torrent's table row.
QCLI_TORRENT_SELECTOR=body table tbody tr

# Search engine URL used by the whitelist card's "search online" button (the query is added as the `q` param).
QCLI_SEARCH_URL=https://www.google.com/search

# Domain the search is restricted to (appended as `site:<domain>`).
QCLI_TITLE_LOOKUP_DOMAIN=lookup.info.com
